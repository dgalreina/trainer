{
  "name": "@trainer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:lambda": "nest build && node scripts/package-lambda.mjs",
    "seed": "node --env-file=.env scripts/seed-exercises.mjs && node --env-file=.env scripts/seed-foods.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1161.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@trainer/shared": "*",
    "aws-jwt-verify": "^5.2.1",
    "mongoose": "^9.11.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3"
  }
}
