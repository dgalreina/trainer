# Puerto local de la API
PORT=3001

# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:8081

# MongoDB Atlas (región UE)
MONGODB_URI=

# Clave de Anthropic: SOLO en el backend, nunca en el cliente
ANTHROPIC_API_KEY=

# Cognito (región UE): user pool y app client de la app
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
